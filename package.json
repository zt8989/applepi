{
  "name": "event-loop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Redux Loop 驱动的 Agent Loop：reducer 纯函数返回 loop(state, Cmd)，LLM 流式调用与工具执行都是 Cmd；Provider 走 Pi（@earendil-works/pi-ai，DeepSeek）。",
  "type": "module",
  "bin": {
    "ela": "./bin/ela.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx src/tui.ts",
    "agent": "node --import tsx src/tui.ts",
    "typecheck": "tsc --noEmit",

    "config:migrate": "node --import tsx scripts/migrate-config-dir.ts",
    "models:migrate": "node --import tsx scripts/migrate-models.ts",

    "test": "node --import tsx --import ./test/isolated-home.ts --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.2",
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "redux": "^4.2.1",
    "redux-loop": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
