{
  "name": "harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "tsx scripts/dev-web.mjs",
    "dev:web": "tsx scripts/dev-web.mjs",
    "serve": "pnpm --filter @applepi/server start",
    "tui": "tsx scripts/tui.mjs",
    "test": "pnpm -r test",
    "verify": "pnpm -r build && pnpm -r test"
  },
  "devDependencies": {
    "@applepi/server": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
