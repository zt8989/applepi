{
  "name": "harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @applepi/agent dev",
    "test": "pnpm -r test",
    "check-ext": "pnpm --filter @applepi/agent check-ext",
    "check-denylist": "pnpm --filter @applepi/agent check-denylist",
    "check-security": "pnpm --filter @applepi/agent check-security",
    "check-memory": "pnpm --filter @applepi/agent check-memory",
    "check-skills": "pnpm --filter @applepi/agent check-skills",
    "check-session": "pnpm --filter @applepi/agent check-session",
    "check-soft-isolation": "pnpm --filter @applepi/agent check-soft-isolation",
    "verify": "pnpm -r build && pnpm -r test && pnpm run check-ext && pnpm run check-denylist && pnpm run check-security && pnpm run check-memory && pnpm run check-skills && pnpm run check-session && pnpm run check-soft-isolation"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
