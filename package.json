{
  "name": "event-loop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Redux Loop 驱动的 Agent Loop：reducer 纯函数返回 loop(state, Cmd)，LLM 流式调用与工具执行都是 Cmd；Provider 走 Pi（@earendil-works/pi-ai，DeepSeek）。分 @ela/core（内核）与 @ela/tui（终端界面）两个包。",
  "type": "module",
  "bin": {
    "ela": "./packages/tui/bin/ela.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx packages/tui/src/main.ts",
    "agent": "node --import tsx packages/tui/src/main.ts",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @ela/webui build && pnpm --filter @ela/tui build",
    "test": "pnpm -r test",
    "core:test": "pnpm --filter @ela/core test",
    "tui:test": "pnpm --filter @ela/tui test",

    "config:migrate": "pnpm --filter @ela/core config:migrate",
    "models:migrate": "pnpm --filter @ela/core models:migrate",
    "repatch:ask-user-question": "pnpm --filter @ela/core repatch:ask-user-question",
    "build:tui": "pnpm --filter @ela/tui build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
