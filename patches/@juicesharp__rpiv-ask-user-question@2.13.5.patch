+// `unanswered:`（partial submit），与扩展自己那份 TUI 对齐。
+
+/** 一道题的表面答案。 */
+export interface ExternalQuestionAnswer {
+	questionIndex: number;
+	kind: "option" | "custom" | "multi";
+	/** `option` = 选项 label；`custom` = 自定义原文；`multi` 不用（看 selected）。 */
+	answer?: string | null;
+	/** `multi` 选中的那些 label。 */
+	selected?: string[];
