+let scopeImpl: ScopeFn = (_key, fallback) => fallback;
+void import("@juicesharp/rpiv-i18n")
+	.then((sdk) => {
+		scopeImpl = (sdk as I18nSDK).scope(I18N_NAMESPACE);
+	})
